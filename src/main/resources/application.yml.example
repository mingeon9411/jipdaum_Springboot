server:
  port: 8081

spring:
  datasource:
    # Django(Team-DaumAna/backend)와 같은 DB를 공유한다.
    # 로컬 실행 전: Team-DaumAna 저장소에서 `docker compose up -d` 로 jibdaum-mysql 컨테이너를 먼저 띄워둘 것.
    url: jdbc:mysql://localhost:3306/jibdaum
    username: root
    password: rootpassword
    driver-class-name: com.mysql.cj.jdbc.Driver
  jpa:
    hibernate:
      # Django 마이그레이션이 스키마를 소유한다. Spring이 스키마를 바꾸지 않도록 반드시 none 유지.
      ddl-auto: none
      naming:
        # Spring 기본 네이밍 전략이 @Table(name="JIPDAUM_CATEGORY")도 강제로 소문자 스네이크케이스로
        # 바꿔버려서 Django가 만든 대문자 테이블과 매칭이 안 됨 - 명시한 이름을 그대로 쓰도록 강제.
        physical-strategy: org.hibernate.boot.model.naming.PhysicalNamingStrategyStandardImpl
    show-sql: true
    open-in-view: false
  servlet:
    multipart:
      max-file-size: 5MB
      max-request-size: 5MB
  mail:
    # 이메일 OTP 발송용. 실제 발송 테스트가 필요 없으면 더미 값으로 둬도 부팅은 됨(연결은 부팅 시 검증 안 함).
    host: smtp.gmail.com
    port: 587
    username: dummy@gmail.com
    password: dummy-app-password
    properties:
      mail:
        smtp:
          auth: true
          starttls:
            enable: true
  security:
    oauth2:
      client:
        registration:
          google:
            client-id: dummy-google-client-id
            client-secret: dummy-google-client-secret
            scope: email, profile
          kakao:
            client-id: dummy-kakao-client-id
            client-secret: dummy-kakao-client-secret
            authorization-grant-type: authorization_code
            redirect-uri: "{baseUrl}/login/oauth2/code/{registrationId}"
            client-authentication-method: client_secret_post
            scope: profile_nickname, account_email
            client-name: Kakao
          naver:
            client-id: dummy-naver-client-id
            client-secret: dummy-naver-client-secret
            authorization-grant-type: authorization_code
            redirect-uri: "{baseUrl}/login/oauth2/code/{registrationId}"
            # 네이버 토큰 엔드포인트는 client 인증을 POST 바디로만 받는다(Basic 헤더 기본값 거부).
            # 카카오와 동일한 제약. 이게 빠지면 인가 코드→토큰 교환 단계에서 네이버가 거부한다.
            client-authentication-method: client_secret_post
            scope: name, email, profile_image
            client-name: Naver
        provider:
          kakao:
            authorization-uri: https://kauth.kakao.com/oauth/authorize
            token-uri: https://kauth.kakao.com/oauth/token
            user-info-uri: https://kapi.kakao.com/v2/user/me
            user-name-attribute: id
          naver:
            authorization-uri: https://nid.naver.com/oauth2.0/authorize
            token-uri: https://nid.naver.com/oauth2.0/token
            user-info-uri: https://openapi.naver.com/v1/nid/me
            user-name-attribute: response

app:
  frontend-url: http://localhost:5173
  upload-dir: ./uploads
  mail:
    from: dummy@gmail.com
  chat:
    rate-limit:
      # 챗봇(POST /api/shop/chat)은 로그인 사용자는 계정 단위, 비로그인은 IP 단위로 토큰 버킷을 나눠 제한한다.
      # capacity개까지 버스트 허용, 이후 refill-minutes마다 refill-tokens개씩 greedy하게 재충전.
      capacity: 30
      refill-tokens: 30
      refill-minutes: 1

hcaptcha:
  # 회원가입/로그인/챗봇 대화 시작 시 사람인지 검증(HCaptchaService). secret-key가 비어있으면
  # 검증을 항상 통과시키므로(로컬 개발 편의) 부팅/테스트는 이 값 없이도 문제 없다.
  secret-key: ''
  verify-url: https://hcaptcha.com/siteverify

jwt:
  # Django SIMPLE_JWT의 SIGNING_KEY(=SECRET_KEY, backend/.env)와 반드시 동일해야 토큰이 양쪽에서 호환된다.
  secret: '***REMOVED_SECRET***'
  expiration: 7200000
  refresh-expiration: 604800000

portone:
  api-secret: dummy-portone-api-secret

gemini:
  # 챗봇 LLM 연동. https://aistudio.google.com 에서 API 키 발급 후 로컬 application.yml에만 채워 넣을 것
  # (이 값이 비어 있으면 ChatService가 자동으로 규칙 기반 답변으로 폴백하므로 부팅/테스트는 문제 없음).
  api-key: ''
  # 3.7-flash는 tool-calling 조합에서 라이브 테스트 중 반복적으로 503(과부하)이 났고,
  # 2.5-flash는 신규 사용자에게 지원 종료(Google이 3.6-flash로 안내)됐다.
  # 3.6-flash로 동일 요청(tool-calling 포함) 테스트 시 안정적으로 성공.
  model: gemini-3.6-flash
  embedding-model: gemini-embedding-001
  base-url: https://generativelanguage.googleapis.com/v1beta
